---
layout: page
---
<div class="post">
  <article>
    <p><a href="{{ '/grupo/' | relative_url }}">← Voltar para o Grupo</a></p>

    {% if page.members and page.members.size > 0 %}
      <div class="row mt-4 justify-content-center">
        {% for member in page.members %}
          <div class="col-sm-6 col-md-4 mb-4">
            <div class="card h-100 text-center p-3">
              {% if member.image %}
                <img src="{{ member.image | prepend: '/assets/img/' | relative_url }}"
                     class="rounded-circle mx-auto mb-2"
                     style="width:5cm;height:5cm;object-fit:cover;object-position:{{ member.image_position | default: 'center top' }};"
                     alt="{{ member.name }}">
              {% endif %}
              <strong>{{ member.name }}</strong>
              {% if member.description %}
                <p class="small text-muted mt-1 mb-1">{{ member.description }}</p>
              {% endif %}
              <div class="mt-1">
                {% if member.lattes %}
                  <a href="{{ member.lattes }}" target="_blank">Currículo Lattes</a>
                {% endif %}
                {% if member.orcid %}
                  &nbsp;·&nbsp;
                  <a href="https://orcid.org/{{ member.orcid }}" target="_blank">ORCID</a>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-muted mt-3"><em>Nenhum membro cadastrado nesta categoria.</em></p>
    {% endif %}
  </article>
</div>
